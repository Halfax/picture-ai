# Secrets - HuggingFace tokens, never commit
token.txt
config/hf_token.txt
.env
.env.local

# Runtime user settings - holds the last-used prompt and seed. This repo is
# pushed to a PUBLIC GitHub remote as well as GitLab, so tracking it published
# whatever was last typed into the GUI. Defaults live in settings_store.py.
config/settings.json

